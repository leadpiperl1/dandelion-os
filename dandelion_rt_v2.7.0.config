# Dandelion OS v2.7.0 ("Heimat-Agora") Clean-Room PREEMPT_RT + sched_ext Config
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_RT_MUTEXES=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_RCU_NOCB_CPU=y
# Linux 6.12 BPF Extensible Scheduler (sched_ext / scx) & eBPF/XDP
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
# Linux 6.12 Zero-Copy & Multishot io_uring IPC
CONFIG_IO_URING=y
# High-Resolution Timers, Tickless Isolated Cores & AMD Zen P-State
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_HZ_1000=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_CPU_IDLE=n
CONFIG_ACPI_PROCESSOR_CSTATE=n
# Filesystems: SquashFS (ZSTD), F2FS (Flash-Friendly USB), Initramfs & UDS
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_F2FS_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
